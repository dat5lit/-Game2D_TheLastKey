# Unity .gitignore (clean version)

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data
!/[Aa]ssets/**/*.meta

# Unity Addressables
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting
/[Aa]ssets/Unity.VisualScripting.Generated/

# Rider / IDE
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
.idea/

# Visual Studio
.vs/
*.csproj
*.sln
*.slnx
*.unityproj
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Logs
*.log

# Crash reports
sysinfo.txt
mono_crash.*

# Build files
*.apk
*.aab
*.unitypackage
*.app

# Gradle
.gradle/

# Misc
ExportedObj/
.consulo/
.vsconfig